# ==== Server ====
PORT=5000
NODE_ENV=production
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CLIENT_ORIGIN=http://127.0.0.1:5500,https://your-frontend.up.railway.app

# ==== Database ====
# Railway injects MYSQL_URL automatically when this service shares a
# project with a Railway MySQL plugin. Leave blank on Railway.
# For local development, either set MYSQL_URL to Railway's public
# connection string, or fill in the DB_* fields for a local MySQL.
MYSQL_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mentorae_sis

# ==== Auth ====
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h
OTP_EXPIRES_MIN=10

# ==== Email (used to send the forgot-password OTP code) ====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM="Mentorae Portal <no-reply@talisayshs.edu.ph>"
